
extends layout

block content
  h1.location-title= pageHeader.title
  hr

  form.review-form(method="post" action="/location/" + location._id + "/review/new")
    .form-row
      label(for="author") Name
      input#author(type="text" name="author" required)

    .form-row
      label(for="rating") Rating
      select#rating(name="rating" required)
        option(value="5" selected) 5
        option(value="4") 4
        option(value="3") 3
        option(value="2") 2
        option(value="1") 1

    .form-row.review-text-row
      label(for="reviewText") Review
      .review-input-area
        textarea#reviewText(name="reviewText" rows="6")
        button.btn-add-review(type="submit") Add my review
