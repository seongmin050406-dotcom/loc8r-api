
extends layout

block content
  h1.location-title= location.name
  p.location-address= location.address

  section.customer-reviews
    a.btn-add-review(href="/location/" + location._id + "/review/new") Add review

    h2 Customer reviews

    if location.reviews && location.reviews.length > 0
      each review in location.reviews
        article.review-card
          .review-meta
            span.review-stars
              each star in [1, 2, 3, 4, 5]
                if star <= Number(review.rating)
                  span ★
                else
                  span ☆
            span.review-author= review.author
            if review.createdOn
              span.review-date= review.createdOn

          .review-body
            p= review.reviewText
    else
      p.no-reviews 아직 등록된 리뷰가 없습니다.
